# ─── Database ────────────────────────────────────────────────────────────────
# Local SQL Server (prod DB)
DATABASE_URL="sqlserver://localhost;database=dev;user=sa;password=Password1234!;encrypt=false;trustServerCertificate=true;connectTimeout=30000"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-256-bit-secret-change-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT="https://aquilabop.openai.azure.com"
AZURE_OPENAI_KEY="your-azure-openai-key"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-02-01"
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT="text-embedding-ada-002"

# ─── Azure Storage ───────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=..."
AZURE_STORAGE_CONTAINER="rigmind-attachments"

# ─── Azure AD SSO ─────────────────────────────────────────────────────────────
AZURE_AD_CLIENT_ID="your-client-id"
AZURE_AD_CLIENT_SECRET="your-client-secret"
AZURE_AD_TENANT_ID="your-tenant-id"

# ─── Azure Key Vault ─────────────────────────────────────────────────────────
AZURE_KEY_VAULT_URL="https://rigmind-kv.vault.azure.net"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ─── n8n ──────────────────────────────────────────────────────────────────────
N8N_USER="admin"
N8N_PASSWORD="change-me-in-production"
N8N_ENCRYPTION_KEY="change-me-in-production-32chars"
N8N_RIGMIND_TOKEN="your-api-token"

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI="http://mlflow:5000"

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
CORS_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── AI Services ─────────────────────────────────────────────────────────────
AI_FAILURE_PREDICTION_URL="http://localhost:8001"
AI_ANOMALY_URL="http://localhost:8002"
AI_NLP_URL="http://localhost:8003"
