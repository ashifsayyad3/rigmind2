// RigMind AI™ — Prisma Schema
// Derived 1:1 from prod.sql (Azure SQL, 155 tables)
// datetimeoffset → DateTime @db.DateTimeOffset

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─── CORE ─────────────────────────────────────────────────────────────────────

model Rig {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.NVarChar(255)
  status               String?   @db.NVarChar(50)
  onContract           Boolean   @default(false) @map("onContract")
  offContractDate      DateTime? @db.DateTimeOffset
  operationStart       DateTime? @db.DateTimeOffset
  projectedUnLatchDate DateTime? @db.DateTimeOffset
  bop1Id               Int?
  bop2Id               Int?
  visible              Boolean   @default(true)
  isRTM                Boolean   @default(false)
  rtmRigId             String?   @db.NVarChar(50)
  operatorId           Int?
  category             String?   @db.NVarChar(100)
  updatedById          Int?
  createdAt            DateTime  @default(now()) @db.DateTimeOffset
  updatedAt            DateTime  @updatedAt @db.DateTimeOffset

  bops_rigs_bop1IdTobops Bop? @relation("rigs_bop1IdTobops", fields: [bop1Id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bops_rigs_bop2IdTobops Bop? @relation("rigs_bop2IdTobops", fields: [bop2Id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wells                    Well[]
  failures                 Failure[]
  nonProductionTimes       NonProductionTime[]
  maintenanceNotifications MaintenanceNotification[]
  rigComponents            RigComponent[]
  rigWellChanges           RigWellChange[]
  rigStatusChanges         RigStatusChange[]
  rigTests                 RigTest[]
  activeBOPAssignments     ActiveBOPAssignment[]
  moas                     Moa[]
  communications           Communication[]
  certificates             Certificate[]
  rcmReports               RcmReport[]
  observations             Observation[]
  calendarEvents           CalendarEvent[]
  rigLandings              RigLanding[]
  userRigs                 UserRig[]
  deferredMaintenanceTasks DeferredMaintenanceTask[]
  nonProdTimeCalcs         NonProdTimeCalculation[]
  prodTimeCalcs            ProdTimeCalculation[]
  availabilityDrilldowns   AvailabilityDrilldown[]
  rigAttachments           RigAttachment[]
  operatorMappings         RigOperatorMapping[]
  rtmAlarmConfigs          RtmAlarmConfiguration[]
  rtmEventData             RtmEventData[]
  barsequences             Barsequence[]
  wellSessions             WellSession[]
  tracks                   Track[]
  dhw                      Dhw[]
  mpd                      Mpd[]
  rigFeatures              RigFeature[]
  brvUploadHistory         BrvUploadHistory[]
  dbaSetTrendsLimits       DbaSetTrendsLimit[]
  rigCertificateComponents RigCertificateComponent[]
  internalFailures         InternalFailure[]
  internalObservations     InternalObservation[]
  issueEquipments          IssueEquipment[]
  watchlistItems           WatchlistItem[]
  rigOperatorEventLogs     RigOperatorEventLog[]
  rigContactUpdates        RigContactUpdate[]
  surveyorStatusChanges    SurveyorStatusChange[]
  rigItems                 RigItem[]
  rigStack                 RigStack[]
  drillingCasings          DrillingCasing[]
  dhwWells                 DhwWell[]
  rtmCasingDatas           RtmCasingData[]
  trendingReadbackMinMax   TrendingReadbackMinMax[]
  availabilityComponent    AvailabilityComponent[]
  kpis                     Kpi[]

  @@map("rigs")
}

model Well {
  id          Int       @id @default(autoincrement())
  name        String    @db.NVarChar(255)
  depth       Float?
  region      String?   @db.NVarChar(100)
  field       String?   @db.NVarChar(100)
  availability String?  @db.NVarChar(50)
  isRemoved   Boolean   @default(false)
  createdById Int?
  rigId       Int?
  createdAt   DateTime  @default(now()) @db.DateTimeOffset
  updatedAt   DateTime  @updatedAt @db.DateTimeOffset

  rig              Rig?              @relation(fields: [rigId], references: [id])
  observations     Observation[]
  rigWellChanges   RigWellChange[]
  wellSessions     WellSession[]
  nonProductionTimes NonProductionTime[]
  drillingCasings  DrillingCasing[]
  rtmCasingDatas   RtmCasingData[]

  @@map("wells")
}

model User {
  id                Int       @id @default(autoincrement())
  firstName         String    @db.NVarChar(100)
  lastName          String    @db.NVarChar(100)
  email             String    @unique @db.NVarChar(255)
  phoneNumber       String?   @db.NVarChar(50)
  roleId            Int?
  canAccessAllRigs  Boolean   @default(false)
  lastActive        DateTime? @db.DateTimeOffset
  deleted           Boolean   @default(false)
  enabled           Boolean   @default(true)
  createdAt         DateTime  @default(now()) @db.DateTimeOffset
  updatedAt         DateTime  @updatedAt @db.DateTimeOffset

  role          Role?         @relation(fields: [roleId], references: [id])
  userRigs      UserRig[]
  notifications Notification[]
  comments      Comment[]
  tasks         Task[]
  notes         Note[]
  digest        UserDigest?
  surveyorStatusChanges SurveyorStatusChange[]

  @@map("users")
}

model Role {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(100)
  title              String?  @db.VarChar(100)
  access             String?  @db.VarChar(50)
  log                String?  @db.VarChar(50)
  position           Int      @default(0)
  enabled            Boolean  @default(true)
  canAccessAdminPanel Boolean @default(false)
  createdAt          DateTime @default(now()) @db.DateTimeOffset
  updatedAt          DateTime @updatedAt @db.DateTimeOffset

  users           User[]
  rolePermissions RolePermission[]
  roleFeatures    RoleFeature[]

  @@map("roles")
}

model UserRig {
  id        Int      @id @default(autoincrement())
  userId    Int
  rigId     Int
  createdAt DateTime @default(now()) @db.DateTimeOffset
  updatedAt DateTime @updatedAt @db.DateTimeOffset

  user User @relation(fields: [userId], references: [id])
  rig  Rig  @relation(fields: [rigId], references: [id])

  @@unique([userId, rigId])
  @@map("userRigs")
}

// ─── FAILURES ─────────────────────────────────────────────────────────────────

model Failure {
  id                  Int       @id @default(autoincrement())
  rigId               Int?
  cause               String?   @db.NVarChar(Max)
  cycleCounts         Int?
  dateOfFailure       DateTime? @db.DateTimeOffset
  description         String?   @db.NVarChar(Max)
  failureType         String?   @db.NVarChar(100)
  impactedFunctions   String?   @db.NVarChar(Max)
  indicationsSymptoms String?   @db.NVarChar(Max)
  mechanism           String?   @db.NVarChar(255)
  moc                 Boolean?
  severity            String?   @db.NVarChar(50)
  status              String?   @db.NVarChar(50)
  bopId               Int?
  failureModeId       Int?
  nptHours            Float?
  componentId         Int?
  equipmentType       String?   @db.NVarChar(100)
  isRemoved           Boolean   @default(false)
  createdById         Int?
  updatedById         Int?
  createdAt           DateTime  @default(now()) @db.DateTimeOffset
  updatedAt           DateTime  @updatedAt @db.DateTimeOffset

  rig                   Rig?                  @relation(fields: [rigId], references: [id])
  failureMode           FailureMode?          @relation(fields: [failureModeId], references: [id])
  correctiveActions     CorrectiveAction[]
  failureObservations   FailureObservation[]
  failureCommunications FailureCommunication[]
  comments              Comment[]
  lessonsLearned        LessonsLearned[]
  linkedFailures1       LinkedFailure[]       @relation("failure1")
  linkedFailures2       LinkedFailure[]       @relation("failure2")
  failureAttachments    FailureAttachment[]
  nptFailures           NptFailure[]
  rcmRecommendationFailureLink RcmRecommendationFailureLink[]
  moaDelays             MoaDelay[]

  @@map("failures")
}

model FailureMode {
  id             Int      @id @default(autoincrement())
  failureMode    String   @db.NVarChar(255)
  failureModeTag String?  @db.NVarChar(100)
  createdAt      DateTime @default(now()) @db.DateTimeOffset
  updatedAt      DateTime @updatedAt @db.DateTimeOffset

  failures              Failure[]
  componentFailureModes ComponentFailureMode[]

  @@map("failureModes")
}

model CorrectiveAction {
  id           Int       @id @default(autoincrement())
  failureId    Int
  serialNumber String?   @db.NVarChar(100)
  partNumber   String?   @db.NVarChar(100)
  vendorOEM    String?   @db.NVarChar(255)
  dateOfRepair DateTime? @db.DateTimeOffset
  description  String?   @db.VarChar(Max)
  actionTaken  String?   @db.NVarChar(Max)
  createdAt    DateTime  @default(now()) @db.DateTimeOffset
  updatedAt    DateTime  @updatedAt @db.DateTimeOffset

  failure Failure @relation(fields: [failureId], references: [id])

  @@map("correctiveActions")
}

model FailureObservation {
  id            Int      @id @default(autoincrement())
  failureId     Int
  observationId Int
  createdAt     DateTime @default(now()) @db.DateTimeOffset
  updatedAt     DateTime @updatedAt @db.DateTimeOffset

  failure     Failure     @relation(fields: [failureId], references: [id])
  observation Observation @relation(fields: [observationId], references: [id])

  @@map("failureObservations")
}

model LessonsLearned {
  id                   Int      @id @default(autoincrement())
  failureId            Int
  investigationResults String?  @db.VarChar(Max)
  learningsImplemented String?  @db.VarChar(Max)
  createdById          Int?
  updatedById          Int?
  createdAt            DateTime @default(now()) @db.DateTimeOffset
  updatedAt            DateTime @updatedAt @db.DateTimeOffset

  failure     Failure                    @relation(fields: [failureId], references: [id])
  attachments LessonsLearnedAttachment[]

  @@map("lessonsLearned")
}

model LinkedFailure {
  id         Int @id @default(autoincrement())
  failure1Id Int
  failure2Id Int

  failure1 Failure @relation("failure1", fields: [failure1Id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  failure2 Failure @relation("failure2", fields: [failure2Id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("linkedFailures")
}

model FailureCause {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(255)
  tooltip   String?  @db.NVarChar(Max)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTimeOffset
  updatedAt DateTime @updatedAt @db.DateTimeOffset

  @@map("failureCause")
}

model FailureMajorDiscovery {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(255)
  tooltip   String?  @db.NVarChar(Max)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTimeOffset
  updatedAt DateTime @updatedAt @db.DateTimeOffset

  @@map("failureMajorDiscovery")
}

// ─── OBSERVATIONS ─────────────────────────────────────────────────────────────

model Observation {
  id                  Int       @id @default(autoincrement())
  dateOfObservation   DateTime? @db.DateTimeOffset
  title               String?   @db.NVarChar(255)
  description         String?   @db.NVarChar(Max)
  status              String?   @db.NVarChar(50)
  severity            String?   @db.NVarChar(50)
  bopId               Int?
  componentId         Int?
  wellId              Int?
  interventionStackId Int?
  surfaceEquipmentId  Int?
  rigId               Int?
  type                String?   @db.NVarChar(100)
  correctionDescription String? @db.NVarChar(Max)
  updatedById         Int?
  isRemoved           Boolean   @default(false)
  createdById         Int?
  createdAt           DateTime  @default(now()) @db.DateTimeOffset
  updatedAt           DateTime  @updatedAt @db.DateTimeOffset

  rig                       Rig?                               @relation(fields: [rigId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bops                      Bop?                               @relation(fields: [bopId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wells                     Well?                              @relation(fields: [wellId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components                Component?                         @relation(fields: [componentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  failureObservations       FailureObservation[]
  observationCommunications ObservationCommunication[]
  observationAttachments    ObservationAttachment[]
  sensorReadings            SensorReading[]
  rcmRecommendationObservationLink RcmRecommendationObservationLink[]
  comments                  Comment[]

  @@map("observations")
}

model ObservationAttachment {
  id             Int       @id @default(autoincrement())
  observationId  Int?
  attachmentId   Int?
  sensorType     String?   @db.NVarChar(100)
  attachmentType String?   @db.NVarChar(100)
  startDate      DateTime? @db.DateTimeOffset
  endDate        DateTime? @db.DateTimeOffset
  createdAt      DateTime  @default(now()) @db.DateTimeOffset
  updatedAt      DateTime  @updatedAt @db.DateTimeOffset

  observation Observation? @relation(fields: [observationId], references: [id])
  attachment  Attachment?  @relation(fields: [attachmentId], references: [id])

  @@map("observationAttachments")
}

model SensorReading {
  id            Int       @id @default(autoincrement())
  observationId Int?
  rigId         Int?
  sensorTag     String?   @db.NVarChar(100)
  timestamp     DateTime? @db.DateTimeOffset
  value         Float?
  startDate     DateTime? @db.DateTimeOffset
  endDate       DateTime? @db.DateTimeOffset
  createdAt     DateTime  @default(now()) @db.DateTimeOffset
  updatedAt     DateTime  @updatedAt @db.DateTimeOffset

  observation Observation? @relation(fields: [observationId], references: [id])

  @@map("sensorReadings")
}

// ─── MAINTENANCE ──────────────────────────────────────────────────────────────

model DeferredMaintenanceTask {
  id                    Int       @id @default(autoincrement())
  rigId                 Int?
  equipmentId           Int?
  equipmentType         String?   @db.NVarChar(100)
  title                 String?   @db.NVarChar(255)
  description           String?   @db.NVarChar(Max)
  componentName         String?   @db.NVarChar(255)
  defermentDate         DateTime? @db.DateTimeOffset
  plannedCompletionDate DateTime? @db.DateTimeOffset
  priority              String?   @db.NVarChar(50)
  status                String?   @db.NVarChar(50)
  isRemoved             Boolean   @default(false)
  createdById           Int?
  updatedById           Int?
  createdAt             DateTime  @default(now()) @db.DateTimeOffset
  updatedAt             DateTime  @updatedAt @db.DateTimeOffset

  rig         Rig?           @relation(fields: [rigId], references: [id])
  attachments DmtAttachment[]

  @@map("deferredMaintenanceTasks")
}

model MaintenanceNotification {
  id            Int      @id @default(autoincrement())
  title         String?  @db.NVarChar(255)
  message       String?  @db.NVarChar(Max)
  rigId         Int?
  assignedAs    String?  @db.NVarChar(100)
  equipmentId   Int?
  equipmentType String?  @db.NVarChar(100)
  type          String?  @db.NVarChar(100)
  createdAt     DateTime @default(now()) @db.DateTimeOffset
  updatedAt     DateTime @updatedAt @db.DateTimeOffset

  rig               Rig?                          @relation(fields: [rigId], references: [id])
  userNotifications UserMaintenanceNotification[]

  @@map("maintenanceNotifications")
}

model MaintenanceTask {
  id            Int      @id @default(autoincrement())
  componentName String?  @db.NVarChar(255)
  issueId       Int?
  issueType     String?  @db.NVarChar(100)
  createdAt     DateTime @default(now()) @db.DateTimeOffset
  updatedAt     DateTime @updatedAt @db.DateTimeOffset

  issueTasks IssueTask[]

  @@map("maintenanceTasks")
}

model ComponentMaintainanceHistory {
  id                   Int       @id @default(autoincrement())
  name                 String?   @db.NVarChar(255)
  rigId                Int?
  uniqueComponentNameId Int?
  componentId          Int?
  maintenanceDate      DateTime? @db.DateTimeOffset
  partNo               String?   @db.NVarChar(100)
  sn                   String?   @db.NVarChar(100)
  pressureRating       Float?
  bop                  Int?
  maintainencePeriod   String?   @db.NVarChar(100)
  lastMaintainenceDate DateTime? @db.DateTimeOffset
  createdAt            DateTime  @default(now()) @db.DateTimeOffset
  updatedAt            DateTime  @updatedAt @db.DateTimeOffset

  @@map("componentMaintainanceHistory")
}

// ─── CERTIFICATES ─────────────────────────────────────────────────────────────

model Certificate {
  id           Int       @id @default(autoincrement())
  rigId        Int?
  equipment    String?   @db.NVarChar(255)
  typeCodeId   Int?
  serialNumber String?   @db.NVarChar(100)
  tag          String?   @db.NVarChar(100)
  manufacturer String?   @db.NVarChar(255)
  partNumber   String?   @db.NVarChar(100)
  expiryDate   DateTime? @db.DateTimeOffset
  issuedDate   DateTime? @db.DateTimeOffset
  status       String?   @db.NVarChar(50)
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.DateTimeOffset
  updatedAt    DateTime  @updatedAt @db.DateTimeOffset

  rig         Rig?                    @relation(fields: [rigId], references: [id])
  typeCode    TypeCode?               @relation(fields: [typeCodeId], references: [id])
  attachments CertificateAttachment[]

  @@map("certificates")
}

model CertificateAttachment {
  id              Int       @id @default(autoincrement())
  certificateId   Int?
  certificateType String?   @db.NVarChar(100)
  attachmentId    Int?
  expirationDate  DateTime? @db.DateTimeOffset
  isDeleted       Boolean   @default(false)
  createdById     Int?
  updatedById     Int?
  createdAt       DateTime  @default(now()) @db.DateTimeOffset
  updatedAt       DateTime  @updatedAt @db.DateTimeOffset

  certificate Certificate? @relation(fields: [certificateId], references: [id])
  attachment  Attachment?  @relation(fields: [attachmentId], references: [id])

  @@map("certificateAttachments")
}

model TypeCode {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(255)
  subType   String?  @db.NVarChar(100)
  bopType   String?  @db.NVarChar(100)
  createdAt DateTime @default(now()) @db.DateTimeOffset
  updatedAt DateTime @updatedAt @db.DateTimeOffset

  certificates Certificate[]

  @@map("typeCodes")
}

model RigCertificateComponent {
  id        Int      @id @default(autoincrement())
  rigId     Int?
  system    String?  @db.NVarChar(255)
  subSystem String?  @db.NVarChar(255)
  equipment String?  @db.NVarChar(255)
  component String?  @db.NVarChar(255)
  fleet     String?  @db.NVarChar(255)
  included  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTimeOffset
  updatedAt DateTime @updatedAt @db.DateTimeOffset

  rig Rig? @relation(fields: [rigId], references: [id])

  @@map("rigCertificateComponents")
}

model CertificateComponentMaster {
  id        Int      @id @default(autoincrement())
  system    String?  @db.NVarChar(255)
  subSystem String?  @db.NVarChar(255)
  equipment String?  @db.NVarChar(255)
  component String?  @db.NVarChar(255)
  fleet     String?  @db.NVarChar(255)
  createdAt DateTime @default(now()) @db.DateTimeOffset
  updatedAt DateTime @updatedAt @db.DateTimeOffset

  @@map("certificateComponentMasters")
}

// ─── NPT ──────────────────────────────────────────────────────────────────────

model NonProductionTime {
  id            Int       @id @default(autoincrement())
  rigId         Int?
  wellId        Int?
  bopType       String?   @db.NVarChar(100)
  delayCategory String?   @db.NVarChar(100)
  operation     String?   @db.NVarChar(255)
  nptHours      String?   @db.NVarChar(50)
  comment       String?   @db.NVarChar(Max)
  nptType       String?   @db.NVarChar(100)
  sourceType    String?   @db.NVarChar(100)
  sourceId      Int?
  dateOfNPT     DateTime? @db.DateTimeOffset
  isRemoved     Boolean   @default(false)
  startTime     DateTime? @db.DateTimeOffset
  endTime       DateTime? @db.DateTimeOffset
  createdAt     DateTime  @default(now()) @db.DateTimeOffset
  updatedAt     DateTime  @updatedAt @db.DateTimeOffset

  rig  Rig?  @relation(fields: [rigId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  well Well? @relation(fields: [wellId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("nonProductionTimes")
}

model NonProdTimeCalculation {
  id           Int       @id @default(autoincrement())
  rigId        Int?
  bopType      String?   @db.NVarChar(100)
  startComment String?   @db.NVarChar(Max)
  stopComment  String?   @db.NVarChar(Max)
  startTime    DateTime? @db.DateTimeOffset
  endTime      DateTime? @db.DateTimeOffset
  createdById  Int?
  createdAt    DateTime  @default(now()) @db.DateTimeOffset
  updatedAt    DateTime  @updatedAt @db.DateTimeOffset

  rig         Rig?         @relation(fields: [rigId], references: [id])
  nptFailures NptFailure[]

  @@map("nonProdTimeCalculations")
}

model ProdTimeCalculation {
  id        Int       @id @default(autoincrement())
  rigId     Int?
  bopType   String?   @db.NVarChar(100)
  startTime DateTime? @db.DateTimeOffset
  endTime   DateTime? @db.DateTimeOffset
  status    Boolean?
  createdAt DateTime  @default(now()) @db.DateTimeOffset
  updatedAt DateTime  @updatedAt @db.DateTimeOffset

  rig Rig? @relation(fields: [rigId], references: [id])

  @@map("prodTimeCalculations")
}

model NptFailure {
  id                       Int      @id @default(autoincrement())
  nonProdTimeCalculationId Int?
  failureId                Int?
  createdAt                DateTime @default(now()) @db.DateTimeOffset
  updatedAt                DateTime @updatedAt @db.DateTimeOffset

  nonProdTimeCalc NonProdTimeCalculation? @relation(fields: [nonProdTimeCalculationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  failure         Failure?                @relation(fields: [failureId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("nptFailures")
}

// ─── BOP ──────────────────────────────────────────────────────────────────────

model Bop {
  id               Int       @id @default(autoincrement())
  name             String?   @db.NVarChar(255)
  type             String?   @db.NVarChar(100)
  location         String?   @db.VarChar(100)
  onDeckDate       DateTime? @db.DateTimeOffset
  splashDate       DateTime? @db.DateTimeOffset
  latchTestStartDate DateTime? @db.DateTimeOffset
  latchUpCompleteDate DateTime? @db.DateTimeOffset
  installationDate DateTime? @db.DateTimeOffset
  vendorOEM        String?   @db.NVarChar(255)
  state            String?   @db.NVarChar(50)
  serialNumber     String?   @db.NVarChar(100)
  createdAt        DateTime  @default(now()) @db.DateTimeOffset
  updatedAt        DateTime  @updatedAt @db.DateTimeOffset

  bopChanges                BopChange[]
  bopEvents                 BopEvent[]
  rigTests                  RigTest[]
  activeBOPAssignments      ActiveBOPAssignment[]
  observations              Observation[]
  rigs_rigs_bop1IdTobops    Rig[]                 @relation("rigs_bop1IdTobops")
  rigs_rigs_bop2IdTobops    Rig[]                 @relation("rigs_bop2IdTobops")

  @@map("bops")
}

model ActiveBOPAssignment {
  id          Int       @id @default(autoincrement())
  name        String?   @db.NVarChar(255)
  rigId       Int?
  bopId       Int?
  rtmRigId    String?   @db.NVarChar(50)
  isActive    Boolean   @default(true)
  startDate   DateTime? @db.DateTimeOffset
  endDate     DateTime? @db.DateTimeOffset
  createdById Int?
  updatedById Int?
  createdAt   DateTime  @default(now()) @db.DateTimeOffset
  updatedAt   DateTime  @updatedAt @db.DateTimeOffset

  rig Rig? @relation(fields: [rigId], references: [id])
  bop Bop? @relation(fields: [bopId], references: [id])

  @@map("activeBOPAssignments")
}

model BopChange {
  id                    Int       @id @default(autoincrement())
  bopId                 Int?
  location              String?   @db.NVarChar(100)
  state                 String?   @db.NVarChar(50)
  splashDate            DateTime? @db.DateTimeOffset
  latchTestStartDate    DateTime? @db.DateTimeOffset
  latchUpCompleteDate   DateTime? @db.DateTimeOffset
  onDeckDate            DateTime? @db.DateTimeOffset
  maintenanceStartDate  DateTime? @db.DateTimeOffset
  plannedReadyDate      DateTime? @db.DateTimeOffset
  actualReadyDate       DateTime? @db.DateTimeOffset
  createdAt             DateTime  @default(now()) @db.DateTimeOffset
  updatedAt             DateTime  @updatedAt @db.DateTimeOffset

  bop Bop? @relation(fields: [bopId], references: [id])

  @@map("bopChanges")
}

model BopEvent {
  id                              Int       @id @default(autoincrement())
  bopId                           Int?
  equipment                       String?   @db.NVarChar(255)
  bopStatus                       String?   @db.NVarChar(100)
  projectedOnDeckDate             DateTime? @db.DateTimeOffset
  actualOnDeckDate                DateTime? @db.DateTimeOffset
  projectedMaintenanceStartDate   DateTime? @db.DateTimeOffset
  actualMaintenanceStartDate      DateTime? @db.DateTimeOffset
  projectedMaintenanceCompleteDate DateTime? @db.DateTimeOffset
  actualMaintenanceCompleteDate   DateTime? @db.DateTimeOffset
  createdAt                       DateTime  @default(now()) @db.DateTimeOffset
  updatedAt                       DateTime  @updatedAt @db.DateTimeOffset

  bop Bop? @relation(fields: [bopId], references: [id])

  @@map("bopEvents")
}

model BopEventChange {
  id            Int       @id @default(autoincrement())
  wellSessionId Int?
