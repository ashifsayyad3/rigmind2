# ── AI Services Dockerfile ─────────────────────────────────────────────────
FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unixodbc-dev \
    gcc \
    g++ \
    gnupg2 \
    && curl https://packages.microsoft.com/keys/microsoft.asc | apt-key add - \
    && curl https://packages.microsoft.com/config/debian/11/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update && ACCEPT_EULA=Y apt-get install -y msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY ai-services/failure-prediction/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY ai-services/failure-prediction ./failure_prediction

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN addgroup --gid 1001 aiservice && \
    adduser --uid 1001 --gid 1001 --no-create-home aiservice

RUN mkdir -p /app/mlruns && chown -R aiservice:aiservice /app
USER aiservice

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8001/health || exit 1

CMD ["uvicorn", "failure_prediction.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
